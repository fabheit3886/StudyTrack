@startuml
title StudyTrack - Diagrama de Classes (Modelo de Domínio)

class Usuario {
    - id: int
    - nome: String
    - email: String
    - senha_hash: String
    + verificar_senha(senha: String): bool
    + alterar_senha(nova_senha: String): void
    + perfil(): String
}

class Aluno {
    - matricula: String
    - turma: String
    - curso: String
    + perfil(): String
}

class Administrador {
    + perfil(): String
}

class Disciplina {
    - id: int
    - nome: String
    - descricao: String
}

class Material {
    - id: int
    - titulo: String
    - tipo: String
    - descricao: String
    - categoria: String
    - autor: String
    - link: String
    + contem_termo(termo: String): bool
}

class PlanoEstudo {
    - id: int
    - nome: String
    - objetivo: String
    - descricao: String
    - data_inicio: Date
    - data_fim: Date
    + esta_ativo(): bool
}

class Atividade {
    - id: int
    - titulo: String
    - descricao: String
    - prazo: Date
    - prioridade: String
    - status: String
    + vincular_material(id_material: int): void
    + alterar_prioridade(nova_prioridade: String): void
    + atualizar_status(novo_status: String): void
    + concluir(): void
}

Usuario <|-- Aluno
Usuario <|-- Administrador

Aluno *-- PlanoEstudo
PlanoEstudo *-- Atividade
Disciplina -- Atividade
Atividade -- Material
@enduml